Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        wget \
        bzip2 \
        ca-certificates \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh

    export PATH="/opt/conda/bin:$PATH"
    conda config --set channel_priority flexible

    conda create -y -n liftoff -c conda-forge -c bioconda \
        python=3.10 liftoff
    conda clean -afy

%environment
    export PATH="/opt/conda/envs/liftoff/bin:/opt/conda/bin:$PATH"
    export LC_ALL=C

%runscript
    exec liftoff "$@"

%help
    Apptainer container with Liftoff installed via conda.

    Usage:
        apptainer run liftoff.sif -g reference.gff -o output.gff target.fa reference.fa
        apptainer exec liftoff.sif liftoff --help
